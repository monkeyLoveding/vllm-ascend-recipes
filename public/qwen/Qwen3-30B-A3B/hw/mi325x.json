    "vllm",
    "serve",
    "Qwen/Qwen3-30B-A3B",
    "--trust-remote-code",
    "--enable-expert-parallel",
    "--distributed_executor_backend",
    "mp",
    "--async-scheduling",
    "--no-enable-prefix-caching",
    "--tensor-parallel-size",
    "1",
    "--quantization",
    "ascend"
  ],
  "docker_command": "docker run --device=/dev/kfd --device=/dev/dri \\\n  --security-opt seccomp=unconfined --group-add video \\\n  --privileged --ipc=host -p 8000:8000 \\\n  -v ~/.cache/huggingface:/root/.cache/huggingface \\\n  vllm/vllm-openai-rocm:latest Qwen/Qwen3-30B-A3B \\\n  --trust-remote-code \\\n  --enable-expert-parallel \\\n  --distributed_executor_backend mp \\\n  --async-scheduling \\\n  --no-enable-prefix-caching \\\n  --tensor-parallel-size 1 \\\n  --quantization ascend",
