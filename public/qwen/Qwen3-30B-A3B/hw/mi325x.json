  "command": "vllm serve Qwen/Qwen3-30B-A3B \\\n  --trust-remote-code \\\n  --enable-expert-parallel \\\n  --distributed_executor_backend mp \\\n  --async-scheduling \\\n  --no-enable-prefix-caching \\\n  --tensor-parallel-size 1 \\\n  --quantization ascend",
