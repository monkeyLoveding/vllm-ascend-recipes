apiVersion: leaderworkerset.x-k8s.io/v1
kind: LeaderWorkerSet
metadata:
  name: {{ lws_name }}
  namespace: {{ namespace }}
spec:
  replicas: 1
  leaderWorkerTemplate:
    size: {{ node_count }}
    restartPolicy: None
    leaderTemplate:
      metadata:
        labels:
          recipe-ci-run: {{ lws_name }}
          role: leader
      spec:
        hostNetwork: true
        dnsPolicy: ClusterFirstWithHostNet
        terminationGracePeriodSeconds: 120
        tolerations: &recipe-ci-tolerations
          - key: dedicated
            operator: Equal
            value: night
            effect: NoSchedule
        affinity: &recipe-ci-affinity
          podAntiAffinity:
            requiredDuringSchedulingIgnoredDuringExecution:
              - labelSelector:
                  matchLabels:
                    recipe-ci-run: {{ lws_name }}
                topologyKey: kubernetes.io/hostname
        containers:
          - name: recipe-ci-leader
            image: {{ image }}
            imagePullPolicy: IfNotPresent
            workingDir: {{ run_root }}/source
            command: &recipe-ci-command
              - bash
              - -c
              - |
                set +e
                bash {{ run_root }}/source/scripts/recipe_ci/run.sh
                status=$?
                status_file={{ run_root }}/pod-status/node${LWS_WORKER_INDEX}.exit
                printf '%s\n' "$status" > "$status_file.tmp"
                mv "$status_file.tmp" "$status_file"
                exec sleep infinity
            env: &recipe-ci-env
              - name: RECIPE_CI_PLAN
                value: {{ plan }}
              - name: RECIPE_CI_INSTALL_AISBENCH
                value: "true"
              - name: RECIPE_CI_INSTALL_MOONCAKE
                value: "true"
              - name: RECIPE_CI_STARTUP_TIMEOUT_SECONDS
                value: "{{ startup_timeout_seconds }}"
              - name: RECIPE_CI_RUN_TIMEOUT_SECONDS
                value: "{{ run_timeout_seconds }}"
              - name: RECIPE_CI_NODE_COUNT
                value: "{{ node_count }}"
              - name: RECIPE_CI_ARTIFACT_ROOT
                value: {{ run_root }}/artifacts
              - name: RECIPE_CI_PLOG_ROOT
                value: {{ run_root }}/plogs
              - name: VLLM_ASCEND_ROOT
                value: /opt/vllm-ascend
              - name: RECIPE_CI_IMAGE
                value: {{ image }}
              - name: GITHUB_SHA
                value: {{ commit }}
              - name: VLLM_LOGGING_LEVEL
                value: ERROR
              - name: VLLM_USE_MODELSCOPE
                value: "True"
              - name: HF_HUB_OFFLINE
                value: "1"
              - name: VLLM_WORKER_MULTIPROC_METHOD
                value: spawn
              - name: TORCH_DEVICE_BACKEND_AUTOLOAD
                value: "0"
            resources: &recipe-ci-resources
              requests:
                huawei.com/ascend-1980: {{ npu_per_node }}
                cpu: 8
                memory: 128Gi
                ephemeral-storage: 20Gi
              limits:
                huawei.com/ascend-1980: {{ npu_per_node }}
                memory: 128Gi
                ephemeral-storage: 20Gi
            securityContext: &recipe-ci-security-context
              privileged: true
            ports:
              - name: coordinator
                containerPort: 29599
              - name: gateway
                containerPort: 38085
            volumeMounts: &recipe-ci-volume-mounts
              - name: shared-volume
                mountPath: /root/.cache
              - name: driver-tools
                mountPath: /usr/local/Ascend/driver
              - name: worklogs
                mountPath: /root/ascend/log
              - name: shm-volume
                mountPath: /dev/shm
        volumes: &recipe-ci-volumes
          - name: shared-volume
            persistentVolumeClaim:
              claimName: {{ pvc_name }}
          - name: driver-tools
            hostPath:
              path: /usr/local/Ascend/driver
          - name: worklogs
            emptyDir: {}
          - name: shm-volume
            emptyDir:
              medium: Memory
              sizeLimit: 16Gi
    workerTemplate:
      metadata:
        labels:
          recipe-ci-run: {{ lws_name }}
          role: worker
      spec:
        hostNetwork: true
        dnsPolicy: ClusterFirstWithHostNet
        terminationGracePeriodSeconds: 120
        tolerations: *recipe-ci-tolerations
        affinity: *recipe-ci-affinity
        containers:
          - name: recipe-ci-worker
            image: {{ image }}
            imagePullPolicy: IfNotPresent
            workingDir: {{ run_root }}/source
            command: *recipe-ci-command
            env: *recipe-ci-env
            resources: *recipe-ci-resources
            securityContext: *recipe-ci-security-context
            volumeMounts: *recipe-ci-volume-mounts
        volumes: *recipe-ci-volumes
