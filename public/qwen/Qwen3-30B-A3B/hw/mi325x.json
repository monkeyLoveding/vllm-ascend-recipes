    "--device=/dev/kfd",
    "--device=/dev/dri",
    "--security-opt",
    "seccomp=unconfined",
    "--group-add",
    "video",
    "--privileged",
    "--ipc=host",
    "-p",
    "8000:8000",
    "-v",
    "~/.cache/huggingface:/root/.cache/huggingface",
    "vllm/vllm-openai-rocm:latest",
